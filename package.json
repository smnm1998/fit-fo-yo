{
  "name": "fit-foyo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @fitfoyo/database db:migrate",
    "db:studio": "pnpm --filter @fitfoyo/database db:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.7.4",
    "turbo": "^2.9.12",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "pnpm": {
    "overrides": {
      "body-parser@<2.4.0": "^2.4.0",
      "qs@<6.16.0": "^6.16.0",
      "proxy-addr@<2.0.8": "^2.0.8",
      "multer@<2.5.0": "^2.5.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "baseline-browser-mapping@<2.11.0": "^2.11.0"
    }
  }
}
