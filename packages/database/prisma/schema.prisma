generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RecordType {
  DIET
  EXERCISE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String?
  refreshTokenHash String?
  nickname     String?
  provider     String?  @default("local")
  providerId   String?
  isGuest      Boolean  @default(false)
  aiUsageCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records         Record[]
  recommendations Recommendation[]
  healthProfile   HealthProfile?

  @@unique([provider, providerId])
  @@index([isGuest, createdAt])
}

model Record {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       RecordType
  rawInput   String     @db.Text
  parsedJson Json
  recordedAt DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  dietItems     DietItem[]
  exerciseItems ExerciseItem[]

  @@index([userId, recordedAt])
  @@index([userId, type, recordedAt])
}

model DietItem {
  id        String    @id @default(cuid())
  recordId  String
  record    Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  name      String
  mealType  MealType?
  quantity  Float?
  unit      String?
  grams     Int?
  calories  Int?
  carbs     Float?
  protein   Float?
  fat       Float?
  estimated Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([recordId])
}


model ExerciseItem {
  id              String   @id @default(cuid())
  recordId        String
  record          Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  name            String
  durationMinutes Int?
  intensity       String?
  caloriesBurned  Int?
  estimated       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([recordId])
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  forDate   DateTime @db.Date
  payload   Json
  createdAt DateTime @default(now())

  @@unique([userId, forDate])
  @@index([userId, forDate])
}

model HealthProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm   Float?
  weightKg   Float?
  conditions String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// 식약처 식품영양성분 DB에서 조회한 값의 캐시 (근거 없는 값은 저장하지 않는다)
model FoodNutrition {
  id              Int      @id @default(autoincrement())
  name            String   @unique // 조회에 쓴 이름 (정규화: 소문자·공백 제거)
  foodCd          String // 식약처 식품코드 — 필수
  foodNm          String // 식약처 식품명 (예: 닭고기_가슴(껍질 제거)_삶은것)
  caloriesPer100g Int // 100g(음료는 100ml)당 kcal
  gramsPerServing Int? // 공식 1회 분량이 있을 때만 (가공식품 포장 내용량)
  referenceDate   String? // 식약처 데이터 기준일
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 식약처에서 못 찾은 이름 — 같은 이름으로 API 를 반복 호출하지 않기 위한 기록
model FoodLookupMiss {
  name         String               @id // 정규화된 이름
  reason       FoodLookupMissReason
  requestCount Int                  @default(1) // 몇 번 요청됐나 → 먼저 채울 음식 우선순위
  checkedAt    DateTime             @default(now()) // 마지막으로 식약처에 물어본 시각 (재조회 기준)
  updatedAt    DateTime             @updatedAt
}

enum FoodLookupMissReason {
  NOT_FOUND // 세 데이터셋 모두 0건
  AMBIGUOUS // 후보가 여러 개라 하나로 못 고름
}
